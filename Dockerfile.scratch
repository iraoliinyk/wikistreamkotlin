# syntax=docker/dockerfile:1
# GraalVM Native Image Scratch Docker Build
# Produces a minimal container (~100-150 MB) with instant startup (<100ms)
# Requires Java 25 and GraalVM Community Edition 25
#
# Build time: ~5-10 minutes (vs ~1 minute for JVM)
# Startup: <100ms (vs 2-4s for JVM)
# Image size: ~100-150 MB (vs ~500 MB for JVM)

FROM ghcr.io/graalvm/native-image-community:24-muslib AS builder
WORKDIR /workspace

# Copy Gradle wrapper and build config
COPY gradlew gradlew
COPY gradle/wrapper/gradle-wrapper.jar gradle/wrapper/gradle-wrapper.jar
COPY gradle/wrapper/gradle-wrapper.properties gradle/wrapper/gradle-wrapper.properties
COPY build.gradle.kts settings.gradle.kts ./
COPY src src

# Build native image using GraalVM buildtools
RUN chmod +x ./gradlew && \
    ./gradlew --no-daemon clean nativeCompile

# Prepare rootfs with native executable and required system libraries
RUN mkdir -p /workspace/rootfs/app && \
    BIN_PATH=$(find /workspace/build/native/nativeCompile -maxdepth 1 -type f -executable ! -name "*.o" | head -n 1) && \
    test -n "$BIN_PATH" && \
    cp "$BIN_PATH" /workspace/rootfs/app/app && \
    mkdir -p /workspace/rootfs/etc/ssl/certs && \
    # Copy CA certificates for HTTPS
    cp /etc/ssl/certs/ca-bundle.crt /workspace/rootfs/etc/ssl/certs/ 2>/dev/null || \
    cp /etc/ssl/certs/ca-certificates.crt /workspace/rootfs/etc/ssl/certs/ca-certificates.crt 2>/dev/null || true && \
    # Copy required POSIX libraries for static musl build
    ldd "$BIN_PATH" 2>/dev/null | awk '{for(i=1;i<=NF;i++) if ($i ~ /^\//) print $i}' | sort -u | \
    xargs -I {} sh -c 'mkdir -p /workspace/rootfs/$(dirname {}) && cp {} /workspace/rootfs/{}' 2>/dev/null || true

# Final scratch stage - contains ONLY:
# - Native executable
# - Required system libraries (libc, libssl, libcrypto, etc.)
# - CA certificates
FROM scratch

WORKDIR /app

# Copy native executable and all required runtime files
COPY --from=builder /workspace/rootfs/ /

EXPOSE 7000
ENV PORT=7000

# Run the native application directly (no JVM needed)
ENTRYPOINT ["/app/app"]

