{
  "dashboard": {
    "id": null,
    "uid": "wikistream-metrics",
    "title": "WikiStream Metrics",
    "tags": ["wikistream", "kafka", "redpanda", "metrics"],
    "timezone": "browser",
    "schemaVersion": 38,
    "version": 1,
    "refresh": "10s",
    "time": {
      "from": "now-15m",
      "to": "now"
    },
    "panels": [
      {
        "id": 1,
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
        "type": "timeseries",
        "title": "Events Consumed from Wikipedia Stream",
        "targets": [
          {
            "expr": "rate(wikistream_events_consumed_from_stream_total[1m])",
            "refId": "A",
            "legendFormat": "Events/sec"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "reqps",
            "color": {"mode": "palette-classic"}
          }
        }
      },
      {
        "id": 2,
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
        "type": "timeseries",
        "title": "Events Persisted to Redpanda",
        "targets": [
          {
            "expr": "rate(wikistream_events_persisted_to_redpanda_total[1m])",
            "refId": "A",
            "legendFormat": "Events/sec"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "reqps",
            "color": {"mode": "palette-classic"}
          }
        }
      },
      {
        "id": 3,
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
        "type": "timeseries",
        "title": "Events Consumed from Redpanda",
        "targets": [
          {
            "expr": "rate(wikistream_events_consumed_from_redpanda_total[1m])",
            "refId": "A",
            "legendFormat": "Events/sec"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "reqps",
            "color": {"mode": "palette-classic"}
          }
        }
      },
      {
        "id": 4,
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
        "type": "timeseries",
        "title": "Events Processed Successfully",
        "targets": [
          {
            "expr": "rate(wikistream_events_processed_success_total[1m])",
            "refId": "A",
            "legendFormat": "Success/sec"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "reqps",
            "color": {"mode": "palette-classic"}
          }
        }
      },
      {
        "id": 5,
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
        "type": "timeseries",
        "title": "Events Failed Processing",
        "targets": [
          {
            "expr": "rate(wikistream_events_processing_failed_total[1m])",
            "refId": "A",
            "legendFormat": "Failures/sec"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "reqps",
            "color": {"mode": "fixed", "fixedColor": "red"}
          }
        }
      },
      {
        "id": 6,
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
        "type": "stat",
        "title": "Total Events Processed",
        "targets": [
          {
            "expr": "sum(wikistream_events_processed_success_total)",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "color": {"mode": "thresholds"}
          }
        }
      },
      {
        "id": 7,
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 24},
        "type": "timeseries",
        "title": "Processing Error Rate (%)",
        "targets": [
          {
            "expr": "100 * (rate(wikistream_events_processing_failed_total[5m]) / (rate(wikistream_events_processed_success_total[5m]) + rate(wikistream_events_processing_failed_total[5m])))",
            "refId": "A",
            "legendFormat": "Error Rate %"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "color": {"mode": "thresholds"},
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": 0, "color": "green"},
                {"value": 1, "color": "yellow"},
                {"value": 5, "color": "red"}
              ]
            }
          }
        }
      },
      {
        "id": 8,
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 24},
        "type": "timeseries",
        "title": "Average Processing Duration",
        "targets": [
          {
            "expr": "rate(wikistream_events_processing_duration_sum[1m]) / rate(wikistream_events_processing_duration_count[1m])",
            "refId": "A",
            "legendFormat": "Avg Duration (s)"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "color": {"mode": "palette-classic"}
          }
        }
      }
    ]
  },
  "overwrite": true
}
