# Copy this file to config/auth-secrets.properties and set strong values.
# The real file is ignored by git and loaded through
# spring.config.import=optional:file:./config/auth-secrets.properties

# JWT issuer used in generated access tokens.
app.security.jwt.issuer=wikistreamkotlin

# Use at least 32 random characters for HS256 signing.
app.security.jwt.secret=replace-with-a-long-random-secret

# Access token lifetime in seconds.
app.security.jwt.access-token-ttl-seconds=42

