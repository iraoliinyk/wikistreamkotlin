# Copy this file to config/cassandra-secrets.properties and fill in real values.
# The real file is ignored by git and imported by Spring Boot through
# spring.config.import=optional:file:./config/cassandra-secrets.properties

# Enable the Astra profile when using DataStax Astra instead of local Cassandra.
spring.profiles.active=astra

# DataStax Astra secure connection bundle.
astra.db.secure-connect-bundle=/absolute/path/to/secure-connect-database.zip

# Choose one authentication strategy:
# 1) Client id + secret
astra.db.client-id=your-client-id
astra.db.client-secret=your-client-secret

# 2) Application token (optional alternative to client id + secret)
astra.db.token=your-application-token

# Optional keyspace override
ASTRA_DB_KEYSPACE=wikistream

